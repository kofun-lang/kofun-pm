# Minimal version selection, in the language's executable slice.
#
# This file is the argument for the design. npm and Cargo resolve by search: a
# solver explores the version space, and a failure is reported in terms of the
# search. Go selects the maximum required version per module and stops — and
# the whole of that fits here, in a slice with no loops, no allocation, and
# fixed-arity records, small enough that a gate can read every decision it
# makes.
#
# An algorithm that fits in this much space is an algorithm a user can hold.
# That is the real reason to prefer it, and the reproducibility is a
# consequence: the selected version is a *function* of the requirement set, so
# it does not depend on iteration order, on which requirement was seen first,
# or on anything a solver would call a heuristic.
#
# The core rule, stated once:
#
#     selected(module) = max { version : (module, version) is required }
#
# There is no conflict case. Two requirements for different versions of one
# module are not a contradiction to be resolved; they are two lower bounds,
# and the larger one satisfies both. This is why MVS has no backtracking and
# why it cannot fail in the way a solver fails.
#
# What *can* fail is checkable and is a closed sum: a module nobody publishes,
# a requirement above every published version, and a graph larger than this
# bounded projection. Each carries what was observed.
#
# The canonical surface — a List of requirements, Text module names, semver —
# does not exist yet; `contracts/` holds the CLI surface alone. This file is
# therefore the only statement of the rule, which is why the gate reads every
# decision it makes rather than pinning it against a richer declaration the way
# the other repositories do. Here a module is a code and a version is an Int,
# which is the same resolution with a smaller vocabulary.

# ------------------------------------------------------------- constants

fn requirement_capacity() -> Int {
    return 4
}

fn registry_capacity() -> Int {
    return 3
}

fn slot_empty() -> Int {
    return 0
}

# The root package: the manifest being resolved. It is a requirer like any
# other — its requirements are lower bounds and carry no special weight — but
# it is the one an explanation names most often, so it has a name.
fn app() -> Int {
    return 1
}

fn slot_live() -> Int {
    return 1
}

# Outcomes. Each carries what was observed rather than a description of it.
fn outcome_selected() -> Int {
    return 1
}

fn outcome_unpublished() -> Int {
    return 2
}

fn outcome_above_published() -> Int {
    return 3
}

fn outcome_unrequired() -> Int {
    return 4
}

fn outcome_major_mismatch() -> Int {
    return 5
}

# ---------------------------------------------------------------- values

# What a module offers: its highest published version. MVS never needs the
# full list — it needs the maximum required, and whether the registry can
# satisfy it.
type Published = {
    module: Int,
    highest: Int,
    state: Int,
}

type Registry = {
    p0_module: Int,
    p0_major: Int,
    p0_highest: Int,
    p0_state: Int,
    p1_module: Int,
    p1_major: Int,
    p1_highest: Int,
    p1_state: Int,
    p2_module: Int,
    p2_major: Int,
    p2_highest: Int,
    p2_state: Int,
}

# One requirement: some package says it needs at least this version of that
# module. "At least" is the whole semantics; a requirement is a lower bound
# and never an upper one.
#
# `requirer` is who said it. It is carried because a selection is only
# explainable if the bounds remember their authors: "v5" is an answer, and
# "v5 because X requires >= 5" is the answer to the question anyone actually
# asks. A solver cannot produce that sentence without narrating its search;
# here it is a lookup, because the rule is a maximum and the explanation is
# whichever input achieved it.
type Requirement = {
    module: Int,
    minimum: Int,
    state: Int,
    requirer: Int,
}

type Requirements = {
    r0_module: Int,
    r0_major: Int,
    r0_minimum: Int,
    r0_state: Int,
    r0_requirer: Int,
    r1_module: Int,
    r1_major: Int,
    r1_minimum: Int,
    r1_state: Int,
    r1_requirer: Int,
    r2_module: Int,
    r2_major: Int,
    r2_minimum: Int,
    r2_state: Int,
    r2_requirer: Int,
    r3_module: Int,
    r3_major: Int,
    r3_minimum: Int,
    r3_state: Int,
    r3_requirer: Int,
}

# The closed resolution domain.
#
# `Selected` carries the version chosen. `Unpublished` carries the module
# nobody offers. `AboveHighest` carries the version that was demanded — the
# demand, not the ceiling, because the caller already knows their own ceiling
# and does not know which requirement was too high. `Unrequired` carries the
# module, for a query about something no one asked for.
type Resolution =
    | Selected(version: Int)
    | Unpublished(module: Int)
    | AboveHighest(demanded: Int)
    | Unrequired(module: Int)
    | MajorMismatch(found: Int)

# --------------------------------------------------------------- helpers

fn eq(left: Int, right: Int) -> Int {
    if left == right {
        return 1
    }
    return 0
}

fn larger(left: Int, right: Int) -> Int {
    if left > right {
        return left
    }
    return right
}

fn resolution_kind(resolution: Resolution) -> Int {
    let mut kind = 0
    match resolution {
        Selected(_) => { kind = outcome_selected() },
        Unpublished(_) => { kind = outcome_unpublished() },
        AboveHighest(_) => { kind = outcome_above_published() },
        Unrequired(_) => { kind = outcome_unrequired() },
        MajorMismatch(_) => { kind = outcome_major_mismatch() },
    }
    return kind
}

fn resolution_payload(resolution: Resolution) -> Int {
    let mut payload = 0
    match resolution {
        Selected(version) => { payload = version },
        Unpublished(module) => { payload = module },
        AboveHighest(demanded) => { payload = demanded },
        Unrequired(module) => { payload = module },
        MajorMismatch(found) => { payload = found },
    }
    return payload
}

# ------------------------------------------------------------ the rule

# How many live requirements name this module. Four comparisons, always: the
# answer does not depend on where in the list the module appears, which is the
# property that makes the resolution order-independent.
fn requirement_count(requirements: Requirements, module: Int) -> Int {
    return requirements.r0_state * eq(requirements.r0_module, module)
        + requirements.r1_state * eq(requirements.r1_module, module)
        + requirements.r2_state * eq(requirements.r2_module, module)
        + requirements.r3_state * eq(requirements.r3_module, module)
}

# The rule itself: the maximum lower bound.
#
# Written as nested `larger` over every slot rather than as a search that
# stops early, so the same requirement set gives the same answer whatever
# order the slots were filled in. A requirement that does not name this module
# contributes 0, which cannot raise a maximum over a real requirement because
# versions start at 1.
fn maximum_required(requirements: Requirements, module: Int) -> Int {
    let a: Int = requirements.r0_state
        * eq(requirements.r0_module, module)
        * requirements.r0_minimum
    let b: Int = requirements.r1_state
        * eq(requirements.r1_module, module)
        * requirements.r1_minimum
    let c: Int = requirements.r2_state
        * eq(requirements.r2_module, module)
        * requirements.r2_minimum
    let d: Int = requirements.r3_state
        * eq(requirements.r3_module, module)
        * requirements.r3_minimum
    return larger(larger(a, b), larger(c, d))
}

fn published_count(registry: Registry, module: Int) -> Int {
    return registry.p0_state * eq(registry.p0_module, module)
        + registry.p1_state * eq(registry.p1_module, module)
        + registry.p2_state * eq(registry.p2_module, module)
}

fn registry_major(registry: Registry, module: Int) -> Int {
    return registry.p0_state * eq(registry.p0_module, module) * registry.p0_major
        + registry.p1_state * eq(registry.p1_module, module) * registry.p1_major
        + registry.p2_state * eq(registry.p2_module, module) * registry.p2_major
}

fn highest_published(registry: Registry, module: Int) -> Int {
    return registry.p0_state * eq(registry.p0_module, module)
            * registry.p0_highest
        + registry.p1_state * eq(registry.p1_module, module)
            * registry.p1_highest
        + registry.p2_state * eq(registry.p2_module, module)
            * registry.p2_highest
}

# Resolve one module.
#
# The order is the contract and the gate reads it: a module nobody requires is
# answered before the registry is consulted, and a module nobody publishes is
# answered before a version is compared. So a query about an unrequired module
# cannot learn whether it exists in the registry, and a resolution failure
# always names the earliest thing that was wrong rather than a consequence of
# it.
fn resolve(
    requirements: Requirements,
    registry: Registry,
    module: Int
) -> Resolution {
    if requirement_count(requirements, module) == 0 {
        return Unrequired(module)
    }
    if published_count(registry, module) == 0 {
        return Unpublished(module)
    }
    # Under URL identity two majors are two modules, so every requirement for
    # one module must name the same major. A disagreement means something
    # upstream dropped the major from the identity, and selecting across a
    # major boundary is the one thing MVS must never do quietly.
    let mismatch: Int = major_mismatch(
        requirements,
        module,
        registry_major(registry, module)
    )
    if mismatch >= 0 {
        return MajorMismatch(mismatch)
    }
    let demanded: Int = maximum_required(requirements, module)
    if demanded > highest_published(registry, module) {
        return AboveHighest(demanded)
    }
    # The whole of minimal version selection. Not the highest published, not
    # the newest compatible — the smallest version that satisfies every stated
    # lower bound, which is why adding a dependency cannot move a version
    # nobody asked to move.
    return Selected(demanded)
}

# ---------------------------------------------------- semantic versioning
#
# A version is `major.minor.patch`, and the major is part of the module's
# identity — Go's answer, and the one that falls out of URL identity rather
# than being bolted on.
#
# The reason it is needed is easy to miss. Semver alone does not stop MVS.
# Given `>= 1.5.0` and `>= 2.0.0`, the maximum is `2.0.0`, and MVS would hand
# that to the package that asked for `1.5.0` — precisely the breaking change
# the major bump was announcing. "Take the maximum" has no idea that 2.0.0 is
# not a bigger 1.x.
#
# Putting the major in the identity means the resolver never compares them,
# because it never sees them as the same module. So the resolver does not grow
# a compatibility mode: it stays a maximum, over `minor.patch`, inside one
# major line where semver's promise is exactly MVS's assumption.
#
# `module` below is therefore an identity that already includes the major. The
# `major` field is carried so a mismatch can be *named* when one appears —
# under URL identity it should not, and a resolver that silently accepted one
# would be selecting across a boundary an author declared.

fn version_scale() -> Int {
    return 1000
}

# One comparable number from a minor.patch pair. Bounded by construction: the
# scale is fixed and the gate records it, so a patch cannot overflow into a
# minor.
fn version_of(minor: Int, patch: Int) -> Int {
    return minor * version_scale() + patch
}

fn version_minor(version: Int) -> Int {
    return version // version_scale()
}

fn version_patch(version: Int) -> Int {
    return version % version_scale()
}

# Whether every live requirement for this module agrees on the major.
#
# Under URL identity two majors are two modules, so a disagreement here means
# something upstream lost the major from the identity. It is a refusal rather
# than an assumption because selecting across a major boundary is the one
# thing MVS must never do quietly.
fn major_mismatch(requirements: Requirements, module: Int, major: Int) -> Int {
    if requirements.r0_state * eq(requirements.r0_module, module) == 1 {
        if requirements.r0_major != major {
            return requirements.r0_major
        }
    }
    if requirements.r1_state * eq(requirements.r1_module, module) == 1 {
        if requirements.r1_major != major {
            return requirements.r1_major
        }
    }
    if requirements.r2_state * eq(requirements.r2_module, module) == 1 {
        if requirements.r2_major != major {
            return requirements.r2_major
        }
    }
    if requirements.r3_state * eq(requirements.r3_module, module) == 1 {
        if requirements.r3_major != major {
            return requirements.r3_major
        }
    }
    return 0 - 1
}

# ------------------------------------------------- transitive requirements
#
# A real graph is not flat: a package's own requirements join the set. The
# question that decides whether MVS needs iteration is whether adding them can
# ever *lower* a selection, and the answer is no — every requirement is a
# lower bound, and a union of lower bounds has a maximum that is at least each
# part's maximum.
#
# Two consequences, both checkable:
#
#   max(A union B) = max(max A, max B)   the maximum is associative, which is
#                                        why one pass over the closure gives
#                                        the same answer as any traversal
#                                        order;
#
#   max(A union B) >= max(A)             adding requirements is monotone, so
#                                        there is no fixed point to iterate
#                                        towards. A solver must iterate
#                                        because its assignment can change
#                                        non-monotonically; MVS cannot.
#
# This is the whole reason a transitive resolve is a single fold rather than a
# loop — which matters here, because the executable slice has no loops and
# would not have let us write the other kind.

# The maximum required for a module across two requirement sets, without
# forming the union first. If this ever disagreed with resolving the merged
# set, the closure would depend on how it was assembled.
fn maximum_across(
    direct: Requirements,
    inherited: Requirements,
    module: Int
) -> Int {
    return larger(
        maximum_required(direct, module),
        maximum_required(inherited, module)
    )
}

# Resolve a module against a two-level closure: the requirements written in
# the manifest, and the ones a dependency brought with it.
#
# The order is the same contract as the flat resolve, and for the same reason:
# a module nobody requires — in either set — is answered before the registry
# is consulted.
fn resolve_closure(
    direct: Requirements,
    inherited: Requirements,
    registry: Registry,
    module: Int
) -> Resolution {
    let required: Int = requirement_count(direct, module)
        + requirement_count(inherited, module)
    if required == 0 {
        return Unrequired(module)
    }
    if published_count(registry, module) == 0 {
        return Unpublished(module)
    }
    let major: Int = registry_major(registry, module)
    let direct_mismatch: Int = major_mismatch(direct, module, major)
    if direct_mismatch >= 0 {
        return MajorMismatch(direct_mismatch)
    }
    let inherited_mismatch: Int = major_mismatch(inherited, module, major)
    if inherited_mismatch >= 0 {
        return MajorMismatch(inherited_mismatch)
    }
    let demanded: Int = maximum_across(direct, inherited, module)
    if demanded > highest_published(registry, module) {
        return AboveHighest(demanded)
    }
    return Selected(demanded)
}

# --------------------------------------------------------------- why
#
# "Why v5?" — "because X requires >= 5."
#
# That sentence is the reason to prefer a maximum over a search, and it is
# worth being precise about why it is available here and not elsewhere. A
# solver's answer to the same question is a history: these constraints were
# tried, this one was relaxed, this assignment survived. The answer depends on
# the search, so explaining it means replaying the search, and the explanation
# is as long as the work was.
#
# Under MVS the selection *is* one of the inputs. So the explanation is a
# lookup — which requirement achieved the maximum — and it is complete: every
# other bound is below it, which is exactly what "maximum" means and why no
# other requirement needs mentioning to justify the answer.
#
# Two details make the answer honest rather than merely available.
#
# Ties are reported, not hidden. Several packages may state the same binding
# bound, and an explanation naming one of them as *the* reason would suggest
# removing it would lower the selection. `agreeing` says how many stated it.
#
# The named requirer does not depend on order. Naming "the first slot at the
# maximum" would make the explanation depend on how the set was assembled,
# which is the property this whole resolver exists to avoid — the selection
# would be order-independent and its explanation would not. So the smallest
# requirer code among those at the maximum is named, which is a function of
# the set rather than of its arrangement.

fn why_because() -> Int {
    return 1
}

fn why_unrequired() -> Int {
    return 2
}

fn why_unresolved() -> Int {
    return 3
}

# No requirer. Above every real code, so `smaller` treats it as the absence it
# is without a branch at every slot.
fn no_requirer() -> Int {
    return 999999
}

fn smaller(left: Int, right: Int) -> Int {
    if left < right {
        return left
    }
    return right
}

# The explanation, as a record beside the closed Resolution rather than as
# payloads on it. A resolution answers what; this answers why, and the two are
# separate questions asked of the same rule.
type Why = {
    kind: Int,
    resolution: Int,
    version: Int,
    requirer: Int,
    agreeing: Int,
    others: Int,
}

# One slot's requirer, if that slot is live, names this module, and states
# exactly the binding bound. Otherwise the absence sentinel.
fn requirer_at(
    state: Int,
    slot_module: Int,
    minimum: Int,
    requirer: Int,
    module: Int,
    bound: Int
) -> Int {
    if state * eq(slot_module, module) * eq(minimum, bound) == 1 {
        return requirer
    }
    return no_requirer()
}

# Who stated the binding bound. The smallest such requirer code, so the answer
# is a function of the set and not of the order it was built in.
fn binding_requirer(requirements: Requirements, module: Int, bound: Int) -> Int {
    let a: Int = requirer_at(
        requirements.r0_state, requirements.r0_module,
        requirements.r0_minimum, requirements.r0_requirer, module, bound
    )
    let b: Int = requirer_at(
        requirements.r1_state, requirements.r1_module,
        requirements.r1_minimum, requirements.r1_requirer, module, bound
    )
    let c: Int = requirer_at(
        requirements.r2_state, requirements.r2_module,
        requirements.r2_minimum, requirements.r2_requirer, module, bound
    )
    let d: Int = requirer_at(
        requirements.r3_state, requirements.r3_module,
        requirements.r3_minimum, requirements.r3_requirer, module, bound
    )
    return smaller(smaller(a, b), smaller(c, d))
}

# How many live requirements for this module state exactly the binding bound.
# One means a single package decided the answer; more means removing any one
# of them would not lower it.
fn agreeing_count(requirements: Requirements, module: Int, bound: Int) -> Int {
    return requirements.r0_state * eq(requirements.r0_module, module)
            * eq(requirements.r0_minimum, bound)
        + requirements.r1_state * eq(requirements.r1_module, module)
            * eq(requirements.r1_minimum, bound)
        + requirements.r2_state * eq(requirements.r2_module, module)
            * eq(requirements.r2_minimum, bound)
        + requirements.r3_state * eq(requirements.r3_module, module)
            * eq(requirements.r3_minimum, bound)
}

fn why_of(
    direct: Requirements,
    inherited: Requirements,
    registry: Registry,
    module: Int
) -> Why {
    let resolution: Resolution = resolve_closure(
        direct, inherited, registry, module
    )
    let kind: Int = resolution_kind(resolution)

    # Nothing requires it, so there is no bound to point at. Answered first,
    # for the same reason `resolve` answers it first: a question about an
    # unrequired module must not learn anything about the registry.
    if kind == outcome_unrequired() {
        let absent: Why = Why(
            kind: why_unrequired(),
            resolution: kind,
            version: 0,
            requirer: 0,
            agreeing: 0,
            others: 0
        )
        return absent
    }

    # A refusal has a reason, but not *this* reason: there is no selection to
    # explain. Saying so is better than naming a bound that decided nothing.
    if kind != outcome_selected() {
        let refused: Why = Why(
            kind: why_unresolved(),
            resolution: kind,
            version: 0,
            requirer: 0,
            agreeing: 0,
            others: 0
        )
        return refused
    }

    let bound: Int = maximum_across(direct, inherited, module)
    let agreeing: Int = agreeing_count(direct, module, bound)
        + agreeing_count(inherited, module, bound)
    let stated: Int = requirement_count(direct, module)
        + requirement_count(inherited, module)
    let explanation: Why = Why(
        kind: why_because(),
        resolution: kind,
        version: bound,
        requirer: smaller(
            binding_requirer(direct, module, bound),
            binding_requirer(inherited, module, bound)
        ),
        agreeing: agreeing,
        # The bounds that did not decide the answer — what `kpm why --all`
        # would list. They are not part of the justification, which is the
        # point: a maximum is justified by one input.
        others: stated - agreeing
    )
    return explanation
}

# The flat case, as the closure with nothing inherited. One rule, not two.
fn why(requirements: Requirements, registry: Registry, module: Int) -> Why {
    return why_of(requirements, no_requirements(), registry, module)
}

# ------------------------------------------------------------ constructors

fn requirements_of(
    m0: Int, j0: Int, v0: Int, s0: Int, q0: Int,
    m1: Int, j1: Int, v1: Int, s1: Int, q1: Int,
    m2: Int, j2: Int, v2: Int, s2: Int, q2: Int,
    m3: Int, j3: Int, v3: Int, s3: Int, q3: Int
) -> Requirements {
    let value: Requirements = Requirements(
        r0_module: m0,
        r0_major: j0,
        r0_minimum: v0,
        r0_state: s0,
        r0_requirer: q0,
        r1_module: m1,
        r1_major: j1,
        r1_minimum: v1,
        r1_state: s1,
        r1_requirer: q1,
        r2_module: m2,
        r2_major: j2,
        r2_minimum: v2,
        r2_state: s2,
        r2_requirer: q2,
        r3_module: m3,
        r3_major: j3,
        r3_minimum: v3,
        r3_state: s3,
        r3_requirer: q3
    )
    return value
}

# An empty requirement set. Named rather than spelled out at every call site,
# because "nothing is required" is a value the explanation path needs and a
# reader should not have to count zeroes to recognise.
fn no_requirements() -> Requirements {
    return requirements_of(
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0
    )
}

fn registry_of(
    m0: Int, j0: Int, h0: Int, s0: Int,
    m1: Int, j1: Int, h1: Int, s1: Int,
    m2: Int, j2: Int, h2: Int, s2: Int
) -> Registry {
    let value: Registry = Registry(
        p0_module: m0,
        p0_major: j0,
        p0_highest: h0,
        p0_state: s0,
        p1_module: m1,
        p1_major: j1,
        p1_highest: h1,
        p1_state: s1,
        p2_module: m2,
        p2_major: j2,
        p2_highest: h2,
        p2_state: s2
    )
    return value
}
