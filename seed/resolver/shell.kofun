# The resolver's shell: the scenario, and what it prints.
#
# Four integers per query — module, outcome kind, payload, and the highest the
# registry publishes — so a reader can see the selection and the ceiling it
# was checked against on one line.

fn emit(registry: Registry, requirements: Requirements, module: Int) -> Int {
    let result: Resolution = resolve(requirements, registry, module)
    print(module)
    print(resolution_kind(result))
    print(resolution_payload(result))
    print(highest_published(registry, module))
    return 0
}

fn emit_closure(
    registry: Registry,
    direct: Requirements,
    inherited: Requirements,
    module: Int
) -> Int {
    let result: Resolution = resolve_closure(direct, inherited, registry, module)
    print(module)
    print(resolution_kind(result))
    print(resolution_payload(result))
    print(highest_published(registry, module))
    return 0
}

# Seven integers per explanation: the module asked about, then the six fields
# of the answer.
#
#   kind        because / unrequired / unresolved
#   resolution  the resolution being explained, so the two never drift apart
#   version     what was selected
#   requirer    who stated the bound that decided it
#   agreeing    how many stated exactly that bound — a tie is visible
#   others      the bounds that did not decide the answer; `kpm why --all`
#
# `agreeing` and `others` are printed for every explanation because an answer
# that named one requirer and stopped would imply removing it lowers the
# selection, which is true only when `agreeing` is 1.
fn emit_why(
    registry: Registry,
    direct: Requirements,
    inherited: Requirements,
    module: Int
) -> Int {
    let answer: Why = why_of(direct, inherited, registry, module)
    print(module)
    print(answer.kind)
    print(answer.resolution)
    print(answer.version)
    print(answer.requirer)
    print(answer.agreeing)
    print(answer.others)
    return 0
}

# One lockable row: the module, what it resolved to, and the payload that
# carries. Three integers, delimited by markers so `scripts/lock.sh` reads the
# block by name rather than by a line offset that every assertion above would
# then have to move with.
fn emit_lock_row(
    registry: Registry,
    direct: Requirements,
    inherited: Requirements,
    members: Requirements,
    workspace: Workspace,
    module: Int
) -> Int {
    let result: Resolution = resolve_workspace(
        direct, inherited, members, workspace, registry, module
    )
    print(module)
    print(resolution_kind(result))
    print(resolution_payload(result))
    return 0
}

fn emit_workspace(
    registry: Registry,
    direct: Requirements,
    inherited: Requirements,
    members: Requirements,
    workspace: Workspace,
    module: Int
) -> Int {
    let result: Resolution = resolve_workspace(
        direct, inherited, members, workspace, registry, module
    )
    print(module)
    print(resolution_kind(result))
    print(resolution_payload(result))
    print(highest_published(registry, module))
    return 0
}

fn emit_why_workspace(
    registry: Registry,
    direct: Requirements,
    inherited: Requirements,
    members: Requirements,
    workspace: Workspace,
    module: Int
) -> Int {
    let answer: Why = why_workspace(
        direct, inherited, members, workspace, registry, module
    )
    print(module)
    print(answer.kind)
    print(answer.resolution)
    print(answer.version)
    print(answer.requirer)
    print(answer.agreeing)
    print(answer.others)
    return 0
}

fn emit_why_flat(
    registry: Registry,
    requirements: Requirements,
    module: Int
) -> Int {
    let answer: Why = why(requirements, registry, module)
    print(module)
    print(answer.kind)
    print(answer.resolution)
    print(answer.version)
    print(answer.requirer)
    print(answer.agreeing)
    print(answer.others)
    return 0
}

# The same explanations, in the words a person reads. Two lines each: the
# answer, then the accounting that keeps it honest.
#
# The indent is the shell's, not the core's — it says the second line belongs
# to the first, which is layout rather than content, and the unit suite should
# be asserting the sentence without having to know how it is arranged on a
# page.
fn emit_rendered_why_flat(
    registry: Registry,
    requirements: Requirements,
    module: Int
) -> Int {
    let answer: Why = why(requirements, registry, module)
    print(render_why(module, answer))
    print("  " + render_bounds(answer))
    return 0
}

fn emit_rendered_why(
    registry: Registry,
    direct: Requirements,
    inherited: Requirements,
    module: Int
) -> Int {
    let answer: Why = why_of(direct, inherited, registry, module)
    print(render_why(module, answer))
    print("  " + render_bounds(answer))
    return 0
}

fn emit_rendered_why_workspace(
    registry: Registry,
    direct: Requirements,
    inherited: Requirements,
    members: Requirements,
    workspace: Workspace,
    module: Int
) -> Int {
    let answer: Why = why_workspace(
        direct, inherited, members, workspace, registry, module
    )
    print(render_why(module, answer))
    print("  " + render_bounds(answer))
    return 0
}

fn main() -> Int {
    # A version is minor.patch inside one major line; the major is part of the
    # identity, so the resolver never compares across it. Printed so the
    # golden records the encoding rather than leaving it to a comment.
    let v: Int = version_of(3, 14)
    print(v)
    print(version_minor(v))
    print(version_patch(v))

    # The bounds this projection resolves within, printed so the golden
    # records them: a reader of the output knows what it was bounded by
    # without reading the source.
    print(requirement_capacity())
    print(registry_capacity())

    # 10 publishes to v7, 20 to v3, 30 to v1.
    let registry: Registry = registry_of(
        10, 1, 7, slot_live(),
        20, 1, 3, slot_live(),
        30, 1, 1, slot_live()
    )

    # An application requiring 10 at v2, and a dependency requiring 10 at v5.
    # MVS selects 5: the larger lower bound satisfies both, and nothing was
    # resolved away.
    #
    # Each bound remembers who stated it, which is what makes the selection
    # explainable: v5 is not merely the answer, it is 20's requirement, and
    # the app's v2 did not decide anything.
    let reqs: Requirements = requirements_of(
        10, 1, 2, slot_live(), app(),
        10, 1, 5, slot_live(), 20,
        20, 1, 3, slot_live(), app(),
        99, 1, 1, slot_live(), app()
    )

    emit(registry, reqs, 10)
    emit(registry, reqs, 20)
    emit(registry, reqs, 99)
    emit(registry, reqs, 30)

    # The same requirement set in a different order gives the same answer.
    # Printed rather than asserted in a comment, so the golden carries it.
    let reordered: Requirements = requirements_of(
        99, 1, 1, slot_live(), app(),
        20, 1, 3, slot_live(), app(),
        10, 1, 5, slot_live(), 20,
        10, 1, 2, slot_live(), app()
    )
    emit(registry, reordered, 10)
    emit(registry, reordered, 20)

    # A demand above everything published, carrying the demand.
    let excessive: Requirements = requirements_of(
        20, 1, 9, slot_live(), app(),
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0
    )
    emit(registry, excessive, 20)

    # And the ceiling itself, which must be selectable.
    let at_ceiling: Requirements = requirements_of(
        10, 1, 7, slot_live(), app(),
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0
    )
    emit(registry, at_ceiling, 10)

    # --- the transitive closure
    #
    # The app asks for 10 at v2 and 20 at v1. A dependency it pulls in asks
    # for 10 at v5 and brings 30 with it. The recorded output carries the
    # selection with and without that dependency, so monotonicity is a fact in
    # the golden rather than a claim in a comment.
    let direct: Requirements = requirements_of(
        10, 1, 2, slot_live(), app(),
        20, 1, 1, slot_live(), app(),
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0
    )
    # Inherited bounds are 20's, not the app's. That is the difference `why`
    # exists to report: the app never asked for 10 at v5, and a reader looking
    # at the lock needs to know whose requirement moved it.
    let inherited: Requirements = requirements_of(
        10, 1, 5, slot_live(), 20,
        30, 1, 1, slot_live(), 20,
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0
    )
    let nothing: Requirements = no_requirements()

    emit_closure(registry, direct, nothing, 10)
    emit_closure(registry, direct, inherited, 10)
    emit_closure(registry, direct, inherited, 20)
    emit_closure(registry, direct, inherited, 30)
    # Swapping the two sets must change nothing: a bound is a bound whichever
    # side it was found on.
    emit_closure(registry, inherited, direct, 10)

    # --- why
    #
    # The selection explained as the maximum it is. Recorded beside the
    # resolutions above so the golden carries both: an explanation that
    # disagreed with the decision it explains would be worse than none, and
    # the gate reads them from the same output.

    # v5, because 20 required it. The app asked for v2 and did not decide the
    # answer — which is the sentence a lock diff needs and the one a solver
    # cannot produce without replaying its search.
    emit_why_flat(registry, reqs, 10)

    # The same explanation from the reordered set. Naming "the first slot at
    # the maximum" would answer differently here; naming the smallest requirer
    # among those at the maximum does not, so the explanation is a function of
    # the set exactly as the selection is.
    emit_why_flat(registry, reordered, 10)

    # A bound stated by only the app, with nothing else in play.
    emit_why_flat(registry, at_ceiling, 10)

    # A tie, with the larger requirer code in the earlier slot. This is the
    # arrangement that separates "the smallest requirer at the maximum" from
    # "the first slot at the maximum" — under the second rule the two lines
    # below differ, and the explanation would depend on how the set was built
    # while the selection did not.
    let tied: Requirements = requirements_of(
        10, 1, 5, slot_live(), 30,
        10, 1, 5, slot_live(), 20,
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0
    )
    let tied_reordered: Requirements = requirements_of(
        10, 1, 5, slot_live(), 20,
        10, 1, 5, slot_live(), 30,
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0
    )
    emit_why_flat(registry, tied, 10)
    emit_why_flat(registry, tied_reordered, 10)

    # Across the closure: the app's v2 is not the reason, 20's v5 is.
    emit_why(registry, direct, inherited, 10)
    # …and with the dependency absent, the app's own bound becomes the reason.
    emit_why(registry, direct, nothing, 10)
    # A module only the dependency requires: the app is not in the answer.
    emit_why(registry, direct, inherited, 30)

    # Nothing to explain, said as such rather than as a bound of zero.
    emit_why(registry, direct, inherited, 99)
    # A refusal has a reason, but not a selection — so the explanation names
    # the resolution and declines to invent a bound.
    emit_why_flat(registry, excessive, 20)

    # --- workspace members
    #
    # The bound this projection resolves within, recorded beside the decisions
    # it bounds rather than in the header, so the line numbers every assertion
    # above reads by do not move.
    print(workspace_capacity())

    # The workspace provides 20 and 40. 20 is *also* published — that is the
    # point: a member must win over the registry, or publishing a package
    # could take over a name the workspace owns. 40 is published nowhere,
    # which is the ordinary case and must work just as well.
    let workspace: Workspace = workspace_of(
        20, slot_live(),
        40, slot_live()
    )

    # A member is a package like any other as far as its own requirements go:
    # 40 needs 10 at v6, which is higher than anything the app or the
    # dependency asked for, so it raises the selection.
    let member_reqs: Requirements = requirements_of(
        10, 1, 6, slot_live(), 40,
        40, 1, 1, slot_live(), app(),
        0, 0, 0, slot_empty(), 0,
        0, 0, 0, slot_empty(), 0
    )

    # A member's requirements join the set, and the maximum rises to meet
    # them: 2 from the app, 5 from the dependency, 6 from the member.
    emit_workspace(registry, direct, inherited, member_reqs, workspace, 10)
    # A member that is also published resolves to the workspace, not to v3.
    emit_workspace(registry, direct, inherited, member_reqs, workspace, 20)
    # A member nobody publishes resolves just the same. If the registry were
    # consulted first this would be Unpublished, which is the bug.
    emit_workspace(registry, direct, inherited, member_reqs, workspace, 40)
    # A module that is not a member is unaffected by the workspace.
    emit_workspace(registry, direct, inherited, member_reqs, workspace, 30)
    # The control: the same query with no workspace at all. 20 is then an
    # ordinary dependency and gets a version, which is what makes the line
    # above a claim about membership rather than about module 20.
    emit_workspace(
        registry, direct, inherited, member_reqs, no_workspace(), 20
    )

    # Explained: the member is the reason for v6, and a member itself is
    # explained by where it comes from rather than by a bound.
    emit_why_workspace(registry, direct, inherited, member_reqs, workspace, 10)
    emit_why_workspace(registry, direct, inherited, member_reqs, workspace, 20)
    emit_why_workspace(registry, direct, inherited, member_reqs, workspace, 40)

    # --- the same explanations, in words
    #
    # Every explanation printed above, in the order it was printed, now as the
    # sentence a person reads. Both forms are in one recorded output on
    # purpose: the machine-readable answer and the human-readable one come
    # from the same `Why` in the same run, so the gate can hold them against
    # each other. A rendering that drifted from the decision it renders would
    # be a confident wrong answer to the question a lock diff asks — and that
    # drift is exactly what nothing catches while the wording lives outside
    # the resolver.
    #
    # Appended rather than interleaved, so every line number the gate already
    # reads by stays where it is. The integers are not superseded: a sentence
    # is a bad thing to parse, and `kpm why --json` will want the fields.
    emit_rendered_why_flat(registry, reqs, 10)
    emit_rendered_why_flat(registry, reordered, 10)
    emit_rendered_why_flat(registry, at_ceiling, 10)
    emit_rendered_why_flat(registry, tied, 10)
    emit_rendered_why_flat(registry, tied_reordered, 10)
    emit_rendered_why(registry, direct, inherited, 10)
    emit_rendered_why(registry, direct, nothing, 10)
    emit_rendered_why(registry, direct, inherited, 30)
    emit_rendered_why(registry, direct, inherited, 99)
    emit_rendered_why_flat(registry, excessive, 20)
    emit_rendered_why_workspace(
        registry, direct, inherited, member_reqs, workspace, 10
    )
    emit_rendered_why_workspace(
        registry, direct, inherited, member_reqs, workspace, 20
    )
    emit_rendered_why_workspace(
        registry, direct, inherited, member_reqs, workspace, 40
    )

    # One refusal the block above never reaches: a module that is required and
    # published nowhere. Its *resolution* has been recorded since the first
    # gate, but its explanation had no line of its own, because as integers it
    # was indistinguishable from a demand above the ceiling — both are kind 3,
    # and the kind was the whole answer. The sentence is not indistinguishable,
    # which is the argument for it: "nobody publishes it" and "you asked above
    # everything published" send a reader to two different fixes.
    emit_why_flat(registry, reqs, 99)
    emit_rendered_why_flat(registry, reqs, 99)

    # --- the lockable resolution
    #
    # What a lock would record: every module the closure names, and what it
    # resolved to. Delimited, because a lock producer that read this by line
    # offset would break every time a decision was added above it — and a
    # producer that breaks on unrelated changes gets replaced by one that
    # guesses. The sentences above are exactly the kind of addition that
    # would have moved it.
    #
    # The members are here on purpose. A lock must record that 20 and 40 came
    # from the workspace and must *not* pin a version for them: a lock that
    # pinned a local path would be wrong on every other machine, which is the
    # reason Member is an outcome rather than a Selected.
    print("-- lock --")
    emit_lock_row(registry, direct, inherited, member_reqs, workspace, 10)
    emit_lock_row(registry, direct, inherited, member_reqs, workspace, 20)
    emit_lock_row(registry, direct, inherited, member_reqs, workspace, 30)
    emit_lock_row(registry, direct, inherited, member_reqs, workspace, 40)
    print("-- end lock --")

    return 0
}
