# The derivation shell: a small dependency graph, and the identities it
# produces.
#
# Three integers per line — a label, the outcome kind, and the identity — so
# the golden records what each closure resolved to and the gate can read the
# relationships between them rather than only their values.

fn emit(label: Int, closure: Closure) -> Int {
    let result: Derivation = derive(closure)
    print(label)
    print(derivation_kind(result))
    print(derivation_payload(result))
    return 0
}

fn main() -> Int {
    # The bound this projection derives within, printed so the golden records
    # it: a reader of the output knows what it was bounded by without opening
    # the source.
    print(input_capacity())

    let tool: Int = 7001
    let settings: BuildSettings = settings_of(1, 2, 3, 4, 5, 6)

    # A leaf: one source.
    let leaf: Closure = closure_of(
        500, slot_live(),
        0, slot_empty(),
        0, slot_empty(),
        0, slot_empty(),
        tool, settings
    )
    emit(1, leaf)

    # A dependency with two sources, and the same two in the other order. The
    # golden carries both, so order-independence is a fact in the recorded
    # output rather than a claim in a comment.
    let dep: Closure = closure_of(
        500, slot_live(), 900, slot_live(),
        0, slot_empty(), 0, slot_empty(), tool, settings)
    emit(2, dep)
    let dep_reordered: Closure = closure_of(
        900, slot_live(), 500, slot_live(),
        0, slot_empty(), 0, slot_empty(), tool, settings)
    emit(3, dep_reordered)

    # An application over that dependency's *derivation*, which is what makes
    # the closure transitive.
    let app: Closure = closure_of(
        1000, slot_live(), identity_of(dep), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool, settings)
    emit(4, app)

    # One byte of the dependency's source moves. Its identity moves, and the
    # application's moves with it.
    let dep_changed: Closure = closure_of(
        500, slot_live(), 901, slot_live(),
        0, slot_empty(), 0, slot_empty(), tool, settings)
    emit(5, dep_changed)
    let app_rebuilt: Closure = closure_of(
        1000, slot_live(), identity_of(dep_changed), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool, settings)
    emit(6, app_rebuilt)

    # The toolchain moves and nothing else. Every identity moves, which is why
    # the toolchain is not optional in the closure.
    let app_new_tool: Closure = closure_of(
        1000, slot_live(), identity_of(dep), slot_live(),
        0, slot_empty(), 0, slot_empty(), 7002, settings)
    emit(7, app_new_tool)

    # Every build setting moves separately. These six lines are deliberately
    # repetitive: the golden and gate can name the exact field that was
    # omitted rather than accepting one opaque settings digest.
    let app_new_output_kind: Closure = closure_of(
        1000, slot_live(), identity_of(dep), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool,
        settings_of(11, 2, 3, 4, 5, 6))
    emit(8, app_new_output_kind)
    let app_new_target: Closure = closure_of(
        1000, slot_live(), identity_of(dep), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool,
        settings_of(1, 12, 3, 4, 5, 6))
    emit(9, app_new_target)
    let app_new_backend: Closure = closure_of(
        1000, slot_live(), identity_of(dep), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool,
        settings_of(1, 2, 13, 4, 5, 6))
    emit(10, app_new_backend)
    let app_new_foreign_abi: Closure = closure_of(
        1000, slot_live(), identity_of(dep), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool,
        settings_of(1, 2, 3, 14, 5, 6))
    emit(11, app_new_foreign_abi)
    let app_new_framework: Closure = closure_of(
        1000, slot_live(), identity_of(dep), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool,
        settings_of(1, 2, 3, 4, 15, 6))
    emit(12, app_new_framework)
    let app_new_debug_info: Closure = closure_of(
        1000, slot_live(), identity_of(dep), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool,
        settings_of(1, 2, 3, 4, 5, 16))
    emit(13, app_new_debug_info)

    # The refusals.
    let empty: Closure = closure_of(
        0, slot_empty(), 0, slot_empty(),
        0, slot_empty(), 0, slot_empty(), tool, settings)
    emit(14, empty)
    let reserved: Closure = closure_of(
        500, slot_live(), absent_digest(), slot_live(),
        0, slot_empty(), 0, slot_empty(), tool, settings)
    emit(15, reserved)
    return 0
}
